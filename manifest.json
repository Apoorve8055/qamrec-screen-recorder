{
  "manifest_version": 3,
  "name": "Qamrec - Private Screen Recorder & Subtitles",
  "version": "2.0.0",
  "description": "Makes recordings look edited: auto-zoom on clicks, cursor and keystroke effects, webcam styling, subtitles. All on your device.",
  "minimum_chrome_version": "116",
  "homepage_url": "https://www.apoorveverma.com",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "src/background/background.ts",
    "type": "module"
  },
  "permissions": [
    "activeTab",
    "downloads",
    "scripting",
    "storage",
    "tabCapture"
  ],
  "commands": {
    "stop-recording": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Stop recording"
    },
    "toggle-pause": {
      "suggested_key": { "default": "Alt+Shift+P" },
      "description": "Pause or resume recording"
    },
    "add-marker": {
      "suggested_key": { "default": "Alt+Shift+M" },
      "description": "Mark a highlight"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
